# Environment - copy to .env and fill in (DO NOT COMMIT .env!)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Example runtime flags (seconds / example values):
# LLM_REQUEST_TIMEOUT=120
# CrewAI telemetry/tracing is disabled by default in this project to avoid
# noisy 401 exporter warnings when no CrewAI cloud credentials are configured.
# CREWAI_DISABLE_TELEMETRY=true

# CrewAI verbose: set to true to enable detailed execution logs. Default false.
# CREWAI_VERBOSE=false
# When CREWAI_VERBOSE=true, set CREWAI_OUTPUT_LOG_FILE to route logs to a file
# (e.g. .dialectic/crewai_verbose.log); an LLM summary (4-5 lines) is then
# printed to the console instead of the full log. If unset, default path is
# <DIALECTIC_LOG_DIR>/crewai_verbose.log.
# CREWAI_OUTPUT_LOG_FILE=.dialectic/crewai_verbose.log

# --- Dialectic quality control ---
# Maximum retries per task in the dialectic cycle. Default 3.
# MAX_RETRIES_PER_TASK=3
# Minimum score to approve a task (0-10). Default 7.5.
# MIN_QUALITY_SCORE=7.5
# Total timeout (seconds) for crew.kickoff() of each dialectic iteration. Default 300.
# CREW_KICKOFF_TIMEOUT=300

# --- OpenAI models by tier ---
# SIMPLE: lightweight tasks (validation, short outputs)
# LLM_MODEL_SIMPLE=gpt-5-nano
# COMPLEX: tasks with tool calling and reasoning (implementation, critique, synthesis)
# LLM_MODEL_COMPLEX=gpt-5-mini
# REASONING: architecture and macro decisions
# LLM_MODEL_REASONING=gpt-5
# PLANNING: crew planning step (defaults to REASONING model if unset)
# LLM_MODEL_PLANNING=o3

# PRD output format: controls which artifacts the PRD exporter will generate in prd_output/
# Valid values (recommended in lowercase; runtime reading is case-insensitive):
#   md    -> generates only the Markdown file (.md)
#   json  -> generates only the JSON file (.json)
#   both  -> generates both: JSON and Markdown
# Expected runtime behavior (should be implemented by the loader):
#   - case-insensitive reading (e.g.: 'BOTH', 'Both', 'both' are equivalent)
#   - if the variable is absent or has an invalid value, the default is 'both'
#   - recommended explicit choice for local development: 'both'
# PRD_OUTPUT_FORMAT=both

# Optional: override the default output directory (Path). If absent, fallback = 'prd_output'.
# PRD_OUTPUT_DIR=prd_output
# Optional: override CrewAI flow persistence DB path. Default = '.dialectic/flows.db'.
# DIALECTIC_FLOW_DB=.dialectic/flows.db

# --- Application logging ---
# Enable centralized rotating logs.
# DIALECTIC_LOG_ENABLED=true
# Root log level for text/json/stderr handlers.
# DIALECTIC_LOG_LEVEL=INFO
# Base directory for log files when explicit file paths are not provided.
# DIALECTIC_LOG_DIR=.dialectic
# Explicit log file paths (default to <DIALECTIC_LOG_DIR>/app.log, app.jsonl, error.log).
# DIALECTIC_TEXT_LOG=.dialectic/app.log
# DIALECTIC_JSON_LOG=.dialectic/app.jsonl
# DIALECTIC_ERROR_LOG=.dialectic/error.log
# Also emit human-readable logs to stderr/console.
# DIALECTIC_LOG_TO_STDERR=true
# Rotating file policy.
# DIALECTIC_LOG_MAX_BYTES=5000000
# DIALECTIC_LOG_BACKUP_COUNT=5

# --- Self-improve controls ---
# Cycle-wide token budget enforced by HookScope.
# SELF_IMPROVE_TOKEN_BUDGET=500000
# Per-agent / per-stage iteration cap inside self-improve.
# SELF_IMPROVE_MAX_ITERATIONS=25
# Timeout for the full pytest validation subprocess used before and after the cycle.
# SELF_IMPROVE_TEST_TIMEOUT=1800
# Minimum PRD score required to continue when consensus was not reached.
# SELF_IMPROVE_MIN_PRD_SCORE=8.5
# Extra retries for transient provider/network failures during PRD, planning, or execution.
# SELF_IMPROVE_LLM_STAGE_RETRIES=2
# Base backoff between transient LLM retries.
# SELF_IMPROVE_LLM_RETRY_BACKOFF_SECONDS=2.0
# Post-run metrics gate: no tracked metric may fall below this fraction of baseline.
# MIN_METRIC_RETENTION=0.95

# --- MCP Server API Keys ---
# Context7: up-to-date library/framework documentation for agents
# CONTEXT7_API_KEY=ctx7sk-...
# Brave Search: web search for real-time information
# BRAVE_API_KEY=...
