# Ambiente - copie para .env e preencha (NÃO COMITAR .env!)
# MINIMAX_API_KEY=your_key_aqui
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Example runtime flags (segundos / valores de exemplo):
# LLM_REQUEST_TIMEOUT=120
# CREWAI_TRACING_ENABLED=true

# --- Controle de qualidade dialético ---
# Máximo de retries por task no ciclo dialético. Default 3.
# MAX_RETRIES_PER_TASK=3
# Score mínimo para aprovar uma task (0-10). Default 7.5.
# MIN_QUALITY_SCORE=7.5
# Timeout total (segundos) para o crew.kickoff() de cada iteração dialética. Default 300.
# CREW_KICKOFF_TIMEOUT=300

# --- Modelos OpenAI por tier ---
# SIMPLE: tarefas leves (validação, outputs curtos)
# LLM_MODEL_SIMPLE=gpt-5-nano
# COMPLEX: tarefas com tool calling e raciocínio (implementação, crítica, síntese)
# LLM_MODEL_COMPLEX=gpt-5-mini
# REASONING: arquitetura e decisões macro
# LLM_MODEL_REASONING=gpt-5

# PRD output format: controla quais artefatos o exportador PRD gerará em prd_output/
# Valores válidos (recomendado em lowercase; leitura na runtime é case‑insensitive):
#   md    -> gera apenas o arquivo Markdown (.md)
#   json  -> gera apenas o arquivo JSON (.json)
#   both  -> gera ambos: JSON e Markdown
# Comportamento runtime esperado (deve ser implementado pelo loader):
#   - leitura case‑insensitive (ex.: 'BOTH', 'Both', 'both' são equivalentes)
#   - se a variável estiver ausente ou tiver valor inválido, o fallback seguro é 'json'
#   - escolha explícita recomendada em desenvolvimento local: 'both'
# PRD_OUTPUT_FORMAT=both

# Opcional: sobrescrever o diretório de saída padrão (Path). Se ausente, fallback = 'prd_output'.
# PRD_OUTPUT_DIR=prd_output
